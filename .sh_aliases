alias gxx=' g++ -std=gnu++20 -O2 -Wall -Wextra -mtune=native -march=native'
# alias gdd='g++ -g -std=c++17 -O2 -Wall -Wextra -D__DEBUG__'
alias a=' ./a.out'
# alias ojp='oj-prepare'
# alias ojt='oj-t-cpp main.cpp'
# alias ojt='for f in test/*.in ; do diff -sc <(timeout 2 ./a.out < $f) ${f/.in/.out} ; done'
# alias ojs='oj-s-cpp main.cpp'
# alias pdf='atril'
# alias ptest='python -m unittest discover'
alias ll=' eza --icons --git --group-directories-first --color-scale -snew -lhg'
alias la=' ls -A'
alias l=' ls -CF'
alias e=' xdg-open .'
alias sp=" curl -F 'sprunge=<-' http://sprunge.us"
alias emacs=' emacs -nw'

# xdg-ninja
alias wget='wget --hsts-file="$XDG_DATA_HOME/wget-hsts"'
alias x='xdg-open'
# wayland
# alias copy='wl-copy'
# X
alias copy='xclip -sel clip'
alias kl='kaggle c list --sort-by latestDeadline'
alias tree=' eza --long --tree --level=2'
alias treee=' eza --long --tree --level=3'
alias ghqcd=" cd \$(ghq root)/\$(ghq list | fzf)"

# Doom Emacs の起動用（環境変数と初期化ディレクトリをXDGに固定）
alias doom='EMACSDIR=~/.config/doom-emacs DOOMDIR=~/.config/doom DOOMLOCALDIR=~/.local/share/doom-emacs emacs --init-directory=~/.config/doom-emacs'
# Lisp有効化などの設定変更を反映する同期コマンド用
alias dsync='EMACSDIR=~/.config/doom-emacs DOOMDIR=~/.config/doom DOOMLOCALDIR=~/.local/share/doom-emacs ~/.config/doom-emacs/bin/doom sync'
